# Copy this file to .env and replace every placeholder.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://police_app:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/police_cases
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Set to true only behind HTTPS in production.
COOKIE_SECURE=false
# Optional: exact public origin, e.g. https://police.example.gov.in
APP_ORIGIN=http://localhost:3000
